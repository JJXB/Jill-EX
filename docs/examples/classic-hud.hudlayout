# Jill-EX HUD layout
# Written by tools/hud_layout.py.  Coordinates are screen pixels in a
# 320x200 frame (x,y = top-left of the element).  Grid columns count
# from grid_origin.  See docs/hud-layout-tool.md.

[layout]
format = jillex-hud-layout
version = 1
name = Original classic HUD
style = classic
canvas = 320x200
grid = 8x8
grid_origin = 0,0
snap = 1
show_grid = 1
zoom = 2
reference =
reference_opacity = 55
reference_scale = 100
reference_pos = 0,0
reference_visible = 1

[part.frame]
kind = rect
x = 8
y = 12
size = 304x180
colour = 7
note = patterned frame ring (E3 frames 0/3/4/6/8/10) + title strip

[part.view]
kind = rect
x = 80
y = 22
size = 232x158
colour = 7
note = playfield viewport

[part.health-box]
kind = box
x = 8
y = 22
size = 64x30
colour = 12

[part.health-label]
kind = text
x = 10
y = 27
size = 36x8
colour = 7
text = HEALTH

[part.health-bar]
kind = rect
x = 48
y = 27
size = 20x7
colour = 4
note = framed 20x7 bar; external pack panels use pips instead

[part.level-box]
kind = box
x = 8
y = 52
size = 64x22
colour = 8

[part.level-label]
kind = text
x = 9
y = 57
size = 30x8
colour = 7
text = LEVEL

[part.level-value]
kind = text
x = 10
y = 65
size = 6x8
colour = 7
text = 0

[part.score-label]
kind = text
x = 41
y = 57
size = 30x8
colour = 7
text = SCORE

[part.score-value]
kind = text
x = 34
y = 65
size = 36x8
colour = 7
note = score digits right-aligned to x=70

[part.inventory-box]
kind = box
x = 8
y = 74
size = 64x84
colour = 8

[part.inventory-grid]
kind = grid
x = 9
y = 78
size = 48x48
colour = 7
cell = 16x16
cells = 3x3

[part.inventory-caption]
kind = box
x = 8
y = 158
size = 64x14
colour = 8

[part.inventory-text]
kind = text
x = 10
y = 162
size = 54x8
colour = 7
text = INVENTORY

[part.hint-strip]
kind = rect
x = 0
y = 192
size = 320x8
colour = 7
note = plain black hint strip
