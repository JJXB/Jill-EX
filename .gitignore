# Final release artifacts: every build_*.cmd copies its distributable output
# here (zip/vpk/pkg/apk) for quick transfer to a console or device.  Remove the
# /Releases/ line if you want to commit release builds to the repository.
/Releases/
/port/xbox/build/

# Reverse-engineering artifacts derived from the original game binaries.
# They are kept locally for development but must not be redistributed:
# extracted executable images, Ghidra projects, decompiled code, disassembly
# listings, string dumps and rendered game art.
/re/img*.bin
/re/proj/
/re/export/
/re/__pycache__/
/re/*.txt
/re/*.asm
/re/*.png

# Demo studio build output and screenshots (generated, contain game art).
/tools/demo_studio/build/
/tools/demo_studio/build32/
/tools/demo_studio/shots/
/tools/demo_studio/demo_studio.ini
/captures/
/demo_studio.ini

# Screenshot/render of the game with the original artwork.
/hiscores_panel.png

# Android build output, machine-specific SDK paths and staged assets.  The APK
# is copied to Releases/ (see build_android.cmd).
/port/android/.gradle/
/port/android/build/
/port/android/app/build/
/port/android/app/.cxx/
/port/android/local.properties
/port/android/app/src/main/assets/